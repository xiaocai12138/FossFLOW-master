# Server Storage Configuration
# Set to true to enable server-side storage for multi-device access
# Default is true - diagrams are saved to ./diagrams directory on the host
ENABLE_SERVER_STORAGE=true

# Git backup (optional)
# Set to true to automatically commit changes to git
ENABLE_GIT_BACKUP=false

# Storage path (inside container)
# This is mapped to ./diagrams on the host via Docker volume
STORAGE_PATH=/data/diagrams

# Backend port (usually doesn't need changing)
BACKEND_PORT=3001

# ==========================================================================
# Observability (可选)：统一图模型 + 指标 / 日志 / Trace 编排
# ==========================================================================
# 关闭时完全不挂载 /api/observability，不影响纯绘图部署
ENABLE_OBSERVABILITY=false

# 关系库驱动：memory（零依赖）| sqlite（Node >= 22，落盘持久化）
OBS_DB_DRIVER=sqlite
# SQLite 文件路径，留空则放在 STORAGE_PATH 下
# OBS_DB_FILE=/data/diagrams/observability.db

# 环境标识，用于多环境隔离
OBS_ENV=prod

# 启用的采集器（逗号分隔）
# skywalking: 服务拓扑 + 实例 + Trace
# prometheus: 系统指标（CPU/内存/QPS/错误率/P95）
OBS_COLLECTORS=skywalking,prometheus

# ---- SkyWalking ----
OBS_SKYWALKING_URL=http://skywalking-oap:12800
OBS_SKYWALKING_TOKEN=
# 拓扑统计窗口（分钟）
OBS_TOPOLOGY_WINDOW_MIN=15

# ---- Prometheus ----
OBS_PROM_URL=http://prometheus:9090
# 指标上用于对齐图节点的标签名（写入时必须带 tag_id）
OBS_PROM_LABEL=tag_id
OBS_PROM_RATE_WINDOW=5m
OBS_PROM_TIMEOUT_MS=4000

# ---- 拓扑同步 ----
# 大于 0 时按秒定时同步，0 表示只能通过 POST /api/observability/sync 手动触发
OBS_SYNC_INTERVAL_SEC=0
